# Production only. Set these in the process/hosting environment.
# The application deliberately does not auto-load this file.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-cryptographically-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=carbon.your-company.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://carbon.your-company.example
DATABASE_URL=postgresql://maritime:replace-password@database:5432/maritime?sslmode=require
# HTTPS termination for python -m maritime.serve (the supplied container entrypoint).
# Use the immediate proxy's actual peer IP; it must strip/set forwarded headers.
TRUST_PROXY_HTTPS=1
WAITRESS_TRUSTED_PROXY=10.0.0.10
# Invitation links are shared manually. Reserved for email recovery; no mail is sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
